# ============================================================
# Modèle de configuration - AUCUN secret réel dans ce fichier
# ============================================================
# Utilisation :
#   Copy-Item .env.example .env   (PowerShell)
#   cp .env.example .env          (Linux / macOS / Git Bash)
# Puis remplacer les valeurs "change_me" dans .env.
# Le fichier .env est ignoré par Git (.gitignore) et par Docker (.dockerignore).
# Ne jamais commiter .env ni écrire de vrais mots de passe ici.

# --- PostgreSQL (conteneur "db") --- OBLIGATOIRE
POSTGRES_DB=uniflow
POSTGRES_USER=uniflow
POSTGRES_PASSWORD=change_me

# --- Application Spring Boot --- OBLIGATOIRE
# Lus par application.properties (spring.datasource.*).
# Dans Docker Compose, l'hôte est le service "db", pas localhost.
# DB_USERNAME et DB_PASSWORD doivent être identiques à POSTGRES_USER et POSTGRES_PASSWORD.
DB_URL=jdbc:postgresql://db:5432/uniflow
DB_USERNAME=uniflow
DB_PASSWORD=change_me

# --- Options --- FACULTATIF (valeurs par défaut indiquées)
SERVER_PORT=8080
APP_PORT=8080
APP_IMAGE=uniflow:latest
